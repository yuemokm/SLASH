import {spawnSync} from 'node:child_process';
import fs from 'node:fs/promises';
import path from 'node:path';
import {buildShareManagementScript,disconnectNetworkShare,reconnectNetworkShare,inspectSharePermissions,type NetworkShareRunner} from '../main/network-share.js';
import {inspectSharingSetup} from '../main/sharing-setup.js';
const scripts:string[]=[];
const decode=(args:readonly string[])=>Buffer.from(args[args.indexOf('-EncodedCommand')+1],'base64').toString('utf16le');
const target={drive:'P:',expectedRemotePath:'\\\\DEMO-HOST\\Demo'};
const update={type:'sharePermissionUpdate' as const,shareName:'Demo',expectedPath:'C:\\Synthetic',expectedFingerprint:'a'.repeat(64),previousAccount:'DEMO-HOST\\alice',account:'DEMO-HOST\\bob',access:'read_only' as const};
scripts.push(buildShareManagementScript(update,'C:\\SyntheticReceipt.json'),buildShareManagementScript({...update,access:'read_write'},'C:\\SyntheticReceipt.json'),buildShareManagementScript({type:'shareStop',shareName:'Demo',expectedPath:'C:\\Synthetic'},'C:\\SyntheticReceipt.json'));
await disconnectNetworkShare({type:'shareDisconnect',...target,clearCredentials:true},async r=>{scripts.push(decode(r.args));return {exitCode:0,stdout:JSON.stringify({status:'succeeded',mappingRemoved:true,credentialsCleared:true}),stderr:''};});
let n=0;const runner:NetworkShareRunner=async r=>{scripts.push(decode(r.args));return {exitCode:0,stdout:JSON.stringify(++n===1?{status:'succeeded',mappingRemoved:true}:{ok:true,state:n===2?'connected':'reused',localPath:'P:',remotePath:target.expectedRemotePath,mappingStatus:'OK',source:'smb'}),stderr:''};};
await reconnectNetworkShare({type:'shareReconnect',...target,authentication:{mode:'username-password',username:'DEMO-HOST\\bob',password:'synthetic-parser-only'}},runner);
await inspectSharingSetup(async r=>{scripts.push(decode(r.args));return {exitCode:0,stdout:JSON.stringify({host:'DEMO',userName:'',qualifiedName:'',identityStatus:'unavailable',currentSid:null,localUsers:[],shares:[],mappings:[],drives:[]}),stderr:''};});
await inspectSharePermissions({shareName:'Demo',expectedPath:'C:\\Synthetic'},async r=>{scripts.push(decode(r.args));return {exitCode:0,stdout:JSON.stringify({shareName:'Demo',path:'C:\\Synthetic',fingerprint:'a'.repeat(64),accounts:[]}),stderr:''};});
const parser=`[Console]::InputEncoding=[Text.UTF8Encoding]::new($false);[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false);$ErrorActionPreference='Stop';$scripts=ConvertFrom-Json ([Console]::In.ReadToEnd());$reports=@();foreach($s in $scripts){$tokens=$null;$errors=$null;$ast=[System.Management.Automation.Language.Parser]::ParseInput([string]$s,[ref]$tokens,[ref]$errors);$reports+=@{errors=@($errors|ForEach-Object{$_.Message});statements=$ast.EndBlock.Statements.Count}};$reports|ConvertTo-Json -Depth 4 -Compress`;
const result=spawnSync('powershell.exe',['-NoLogo','-NoProfile','-NonInteractive','-EncodedCommand',Buffer.from(parser,'utf16le').toString('base64')],{input:JSON.stringify(scripts),encoding:'utf8',windowsHide:true,timeout:30000});
const reports=JSON.parse(result.stdout.replace(/^\uFEFF/,''));const passed=result.status===0&&reports.every((r:{errors:string[]})=>r.errors.length===0);
const evidence={kind:'PowerShell AST parse only',commandsExecuted:false,systemShareMutation:false,scripts:scripts.length,reports,exitCode:result.status,passed};const dir=path.resolve('.test-data');await fs.mkdir(dir,{recursive:true});const file=path.join(dir,`share-management-ast-${Date.now()}.json`);await fs.writeFile(file,JSON.stringify(evidence,null,2));console.log(JSON.stringify({file,...evidence},null,2));if(!passed)process.exitCode=1;
