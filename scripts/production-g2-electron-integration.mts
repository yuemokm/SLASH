 view=await call({type:'taskDeliveryGet',runId:exportRun});assert.equal(view.allowed,true,JSON.stringify(view.items));await screenshot('real-delivery-ui');await call({type:'export',mountId:change.mountId,path:change.path,format:'copy',expectedContentHash:hash(content)});const copiedBytes=await fs.readFile(target);assert.deepEqual(copiedBytes,Buffer.from(content));check('实际界面逐项核对经preload/main保存，正式copy输出与核对版本一致');
