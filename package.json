{
  "name": "slash",
  "version": "0.3.12",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "description": "slash 产品经理工作台",
  "author": "slash",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build && tsc -p tsconfig.node.json",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "tsx --test --test-concurrency=4 --test-reporter=tap tests/*.test.ts tests/*.test.mjs",
    "pack": "npm run build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "local.pmslash.desktop",
    "productName": "slash",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "public/brand/slash.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "slash-${version}-portable.exe"
    },
    "compression": "normal"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@langfuse/pi-observability-plugin": "0.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@plannotator/pi-extension": "0.28.8",
    "@sinclair/typebox": "^0.34.52",
    "acorn": "8.19.0",
    "adm-zip": "^0.6.1",
    "docx": "^9.7.1",
    "exceljs": "4.4.0",
    "jiti": "2.7.0",
    "mammoth": "^1.12.3",
    "pdf-parse": "2.4.5",
    "pi-goal-x": "0.32.3",
    "pi-lens": "4.4.0",
    "pi-mcp-adapter": "5.1.0",
    "pi-memory": "0.4.2",
    "pi-subagents": "0.76.1",
    "pi-web-access": "0.37.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "saxes": "6.0.0",
    "undici": "7.29.1",
    "unified": "11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
