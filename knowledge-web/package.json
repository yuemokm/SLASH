{
  "name": "slash-knowledge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "check": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:db": "tsx scripts/test-database.ts",
    "deploy:preflight": "tsx --env-file-if-exists=.env.local scripts/deploy-preflight.ts",
    "publish:bundle": "tsx --env-file-if-exists=.env.deployer.local scripts/publish-bundle.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgtap": "0.0.9",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  }
}
