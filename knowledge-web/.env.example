# Only these two public values are compiled into the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: OpenAI-compatible /embeddings and /chat/completions contracts.
# No model or dimension is guessed. Must match the published snapshot fingerprint.
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_REVISION=
EMBEDDING_DIMENSIONS=
# Set true ONLY if your configured provider accepts the dimensions parameter.
EMBEDDING_SEND_DIMENSIONS=false
ANSWER_BASE_URL=
ANSWER_API_KEY=
ANSWER_MODEL=
# Explicit cosine similarity threshold, calibrated against real Chinese questions.
RETRIEVAL_MIN_SIMILARITY=

# Offline deployer uses a SEPARATE .env.deployer.local (ignored), containing only
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_DEPLOYER_SECRET_KEY. Never put that secret
# in this web environment or Vercel; deploy:preflight rejects it.

# Development only. Explicitly disabled in production and on Vercel.
# No real credentials or Supabase connection required for local UI demonstration.
KNOWLEDGE_LOCAL_FIXTURE=false
